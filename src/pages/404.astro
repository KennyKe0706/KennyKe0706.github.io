---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/content.css";
---

<BaseLayout
  title="Page not found — Kenny Ke"
  description="The requested page could not be found."
>
  <Header />
  <main id="main-content" class="error-page section-shell">
    <p class="section-number">404 / Page not found</p>
    <h1>This page is outside the current scope.</h1>
    <p>The address may have changed, or the page may no longer exist.</p>
    <div class="error-actions">
      <a class="button button-primary" href="/"
        >Return home <span aria-hidden="true">→</span></a
      >
      <a class="button button-quiet" href="/projects/"
        >View projects <span aria-hidden="true">→</span></a
      >
      <a
        class="button button-quiet"
        href="https://github.com/KennyKe0706"
        target="_blank"
        rel="noreferrer"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
