---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/content.css";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects — Kenny Ke"
  description="Source-backed software project case studies by Zixuan (Kenny) Ke."
>
  <Header />
  <main id="main-content" class="projects-page">
    <section
      class="projects-index section-shell"
      aria-labelledby="projects-title"
    >
      <SectionHeader
        index="01"
        label="Project archive"
        title="Projects and implementation notes"
        description="A concise record of what each project does, how its core logic works, and what it does not yet support."
        headingId="projects-title"
        headingLevel={1}
      />
      <ProjectGrid projects={projects} />
    </section>
  </main>
  <Footer />
</BaseLayout>
