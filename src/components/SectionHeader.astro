---
interface Props {
  index: string;
  label: string;
  title: string;
  description: string;
  headingId?: string;
  headingLevel?: 1 | 2;
}

const {
  index,
  label,
  title,
  description,
  headingId,
  headingLevel = 2,
} = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<header class="section-header" data-reveal>
  <p class="section-number">{index} / {label}</p>
  <Heading id={headingId}>{title}</Heading>
  <p>{description}</p>
</header>
