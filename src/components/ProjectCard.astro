---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const detailHref = `/projects/${project.id}/`;
const kindLabel = project.data.kind === "prototype" ? "Prototype" : "Tool";
---

<article class="project-card" data-reveal>
  <a
    class="project-visual project-main-link"
    href={detailHref}
    aria-label={`Read the ${project.data.title} case study`}
  >
    <img
      src={project.data.cover}
      alt={project.data.coverAlt}
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    />
    <span class="visual-caption"
      >{project.data.concepts.slice(0, 2).join(" / ")}</span
    >
  </a>
  <div class="project-info">
    <p class="project-meta">
      <span>{String(index + 1).padStart(2, "0")}</span>
      {kindLabel} · {project.data.technologies.slice(0, 2).join(" · ")}
    </p>
    <h3>
      <a class="project-main-link" href={detailHref}>{project.data.title}</a>
    </h3>
    <p>{project.data.summary}</p>
    <div class="project-actions">
      <a class="project-link" href={project.data.demo}
        >Live Demo <i aria-hidden="true">→</i></a
      >
      <a class="project-link" href={detailHref}
        >Case Study <i aria-hidden="true">→</i></a
      >
      <a
        class="project-link"
        href={project.data.repository}
        target="_blank"
        rel="noreferrer"
      >
        Source Code <i aria-hidden="true">↗</i>
      </a>
    </div>
  </div>
</article>
